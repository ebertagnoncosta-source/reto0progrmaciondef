let fruita = Object.freeze ({
    0: "meló",
    1: "préssec",
    2: "albercoc",
    3: "papaia",
    length: 4
});
// Modificam
fruita[1] = "préssec";
fruita[3] = "papaia";
fruita.length = 4;
console.log(fruita);

